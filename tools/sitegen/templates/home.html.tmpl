{{define "content"}}
<section class="hero">
  <div class="hero__copy">
    <p class="eyebrow">{{ icon "sparkles" }} Local-First · AI-Powered · Custom Worlds &amp; Rules</p>
    <h1 class="hero__title"><span class="wordmark">LocalRPG</span></h1>
    <p class="hero__lede">
      Craft original worlds with AI-assisted generation, build custom tabletop rules with automated
      test scenarios, and embark on solo campaigns with local AI as a first-class citizen. LocalRPG
      brings your adventures to life with multi-voice narration, speech-to-text dictation, style-pack
      scene imagery, and shareable visual novel exports.
    </p>
    <div class="hero__actions">
      <a class="button button--primary" href="{{ .RepoURL }}/releases" target="_blank" rel="noopener">
        {{ icon "download" }} Download
      </a>
      <a class="button" href="{{ .Root }}docs/index.html">{{ icon "book" }} Read the docs</a>
      <a class="button button--ghost" href="{{ .RepoURL }}" target="_blank" rel="noopener">
        {{ icon "github" }} Source
      </a>
    </div>
    <ul class="hero__facts">
      <li><strong>Local AI</strong> First-class local &amp; ONNX embeddings</li>
      <li><strong>Voices</strong> Narration, NPC speech &amp; STT dictation</li>
      <li><strong>Theatre</strong> Replay &amp; export web/video bundles</li>
    </ul>
  </div>

  <div class="hero__stage" aria-hidden="true">
    <div class="stage glass">
      <div class="stage__rail">
        <span class="stage__dot"></span>
        <span class="stage__dot"></span>
        <span class="stage__dot"></span>
        <span class="stage__title">Launcher Hub</span>
      </div>
      <div class="stage__body">
        <div class="stage__dock">
          <span class="stage__chip is-active"><img src="{{ .Root }}assets/logo.svg" alt="" width="26" height="26" /></span>
          <span class="stage__chip"></span>
          <span class="stage__chip"></span>
          <span class="stage__chip"></span>
        </div>
        <div class="stage__main">
          <div class="stage__banner">
            <span class="stage__banner-title">The Ashen Reach</span>
            <span class="stage__banner-sub">Narrative 2d6 · Turn 14</span>
          </div>
          <div class="stage__cards">
            <div class="stage__card">
              <span class="stage__card-name">Emberwatch</span>
              <span class="stage__card-meta">Last played today</span>
            </div>
            <div class="stage__card">
              <span class="stage__card-name">Wild Stars</span>
              <span class="stage__card-meta">Turn 3</span>
            </div>
          </div>
          <div class="stage__panel">
            <span class="stage__line"></span>
            <span class="stage__line stage__line--short"></span>
            <span class="stage__line"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="features" class="section">
  <header class="section__head">
    <p class="eyebrow">{{ icon "grid" }} Capabilities</p>
    <h2>Everything your campaign needs to come alive</h2>
    <p class="section__lede">
      From custom mechanics to living lore, LocalRPG gives you complete creative freedom.
      Bring your own local AI models, immerse yourself in spoken dialogue and generated imagery,
      and capture your story forever.
    </p>
  </header>

  <div class="cards">
    <article class="card glass">
      <span class="card__icon">{{ icon "cpu" }}</span>
      <h3>First-Class Local AI &amp; Embeddings</h3>
      <p>Connect local LLMs via Ollama, LM Studio, or vLLM, run pure-local ONNX embeddings for semantic memory, or play instantly with zero-GPU built-ins that require no setup.</p>
    </article>
    <article class="card glass">
      <span class="card__icon">{{ icon "sparkles" }}</span>
      <h3>AI World Generation &amp; Living Lore</h3>
      <p>Author factions, locations, and starter lore by hand, or generate complete, cohesive settings with schema-first AI pipelines, batch entity expansion, and draft review.</p>
    </article>
    <article class="card glass">
      <span class="card__icon">{{ icon "shield" }}</span>
      <h3>Custom Systems &amp; Scenario Testing</h3>
      <p>Design dice mechanics, outcome tiers, and character creation prompts with worked examples in Systems Studio, and prove system balance with automated test scenarios.</p>
    </article>
    <article class="card glass">
      <span class="card__icon">{{ icon "image" }}</span>
      <h3>Dynamic Scene Art &amp; Style Packs</h3>
      <p>Bring scenes to life with curated art style packs and procedural vector art, preserving permanent world aesthetics while reflecting dynamic character appearance changes.</p>
    </article>
    <article class="card glass">
      <span class="card__icon">{{ icon "layers" }}</span>
      <h3>TTS Narration &amp; Voice Dictation</h3>
      <p>Hear prose narrated aloud while NPCs speak with distinct voice profiles and pitch. Take your turns hands-free using click-to-talk speech-to-text dictation.</p>
    </article>
    <article class="card glass">
      <span class="card__icon">{{ icon "book" }}</span>
      <h3>Story Theatre, Packages &amp; Export</h3>
      <p>Relive adventures in visual novel Theatre Mode, share worlds and rules via standalone content packages, and export complete campaigns as web bundles or rendered video.</p>
    </article>
  </div>
</section>

<section id="screenshots" class="section">
  <header class="section__head">
    <p class="eyebrow">{{ icon "image" }} The look</p>
    <h2>Glassmorphic panels, translucent and quiet</h2>
    <p class="section__lede">
      {{ if .ShotCount }}A tour of the studios, the theatre and the codex.{{ else }}Screenshots are captured from a running build; run <code>mise run site:screenshots</code> to fill this gallery in.{{ end }}
    </p>
  </header>

  <div class="gallery">
    {{ range .Shots }}
    <figure class="shot{{ if not .Present }} is-pending{{ end }}">
      <div class="shot__frame">
        {{ if .Present }}
          <img src="{{ $.Root }}screenshots/{{ .File }}" alt="{{ .Title }}" loading="lazy" decoding="async" />
        {{ else }}
          <div class="shot__placeholder">
            {{ icon "image" }}
            <span>{{ .Title }}</span>
            <small>awaiting capture</small>
          </div>
        {{ end }}
      </div>
      <figcaption>
        <h3>{{ .Title }}</h3>
        <p>{{ .Caption }}</p>
      </figcaption>
    </figure>
    {{ end }}
  </div>
</section>

<section id="quickstart" class="section">
  <header class="section__head">
    <p class="eyebrow">{{ icon "terminal" }} Get started</p>
    <h2>From a clone to a campaign</h2>
  </header>

  <div class="split">
    <div class="split__col">
      <h3>Launch the desktop app</h3>
      <pre class="code" data-copy><code># Fetch dependencies and build
mise run setup
mise run build

# Launch the desktop app
bin/localrpg gui</code></pre>
      <p class="muted">
        Configure your preferred local AI models in Settings Studio, or jump straight in with the built-in zero-GPU storytelling engine.
      </p>
    </div>
    <div class="split__col">
      <h3>Create a world and play</h3>
      <pre class="code" data-copy><code># Or export an existing campaign as a standalone web bundle
bin/localrpg export web my-campaign --out dist/

# Or render your campaign into a shareable video
bin/localrpg export video my-campaign --out campaign.webm</code></pre>
      <p class="muted">
        Design custom worlds and mechanics in the built-in studios, start a new campaign, and export your journey when complete.
      </p>
    </div>
  </div>
</section>

<section id="docs" class="section">
  <header class="section__head">
    <p class="eyebrow">{{ icon "book" }} Documentation</p>
    <h2>The same guide the app ships</h2>
    <p class="section__lede">
      These articles are read straight out of the repository and embedded into the binary,
      so what you read here is what the Help panel shows in-game.
    </p>
  </header>

  <div class="doc-groups">
    {{ range .Groups }}
    <section class="doc-group glass">
      <h3 class="doc-group__title">{{ .Category }}</h3>
      <ul class="doc-group__list">
        {{ range .Docs }}
        <li>
          <a href="{{ $.Root }}{{ .URL }}">
            <span class="doc-group__name">{{ .Title }}</span>
            {{ if .Description }}<small>{{ .Description }}</small>{{ end }}
          </a>
        </li>
        {{ end }}
      </ul>
    </section>
    {{ end }}
  </div>

  <p class="section__foot">
    <a class="button" href="{{ .Root }}docs/index.html">{{ icon "book" }} Browse all documentation</a>
  </p>
</section>
{{end}}
