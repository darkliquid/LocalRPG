.superpowers/
node_modules/
frontend/node_modules/
bin/
/dist/
frontend/dist/
pkg/gui/dist/*
!pkg/gui/dist/.gitkeep

# Local campaign content and caches, created through the studios or by hand.
/systems/
/worlds/
/games/
/cache/

# The showcase site is generated from README.md and pkg/gui/docs by tools/sitegen.
/website/dist/

# Secrets and scratch notes. The app writes provider API keys into a workspace
# override when it runs in project mode, so those files must never be committed;
# the documented way to point at a key is `api_key: "env:OPENAI_API_KEY"`.
*.key
todo.txt
*-session.txt
/localrpg.yaml
/config.yaml
.env
.env.*

.gograph/

# Vale's StylesPath. `vale sync` rebuilds the downloaded styles from the Packages
# key in .vale.ini, so those are ignored, but the vocabulary we wrote is committed.
# The ladder is needed because git cannot re-include a file under an excluded
# directory, so each level is un-ignored before the next is excluded.
/styles/*
!/styles/config/
/styles/config/*
!/styles/config/vocabularies/
/styles/config/vocabularies/*
!/styles/config/vocabularies/LocalRPG/

# Binaries
/localrpg
